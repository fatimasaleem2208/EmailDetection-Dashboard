{
  "manifest_version": 3,
  "name": "EmailDetection \u2014 URL & Gmail Quick Scan",
  "version": "0.3.0",
  "description": "Check website URLs and manually analyze a selected open Gmail message using EmailDetection.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EmailDetection \u2014 URL & Gmail Quick Scan",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://emaildetection-dashboard.vercel.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
