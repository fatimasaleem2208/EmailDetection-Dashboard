{
  "manifest_version": 3,
  "name": "EmailDetection \u2014 URL Check",
  "version": "0.1.0",
  "description": "Check the current website URL for phishing warning signs, then open it in your EmailDetection app.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check this URL with EmailDetection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}